# M2 Studios Website - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# N8n Configuration
N8N_BASE_URL=http://localhost:5678/webhook
N8N_PAGE_SAVE_WEBHOOK=your-page-save-webhook-id
N8N_PAGE_LOAD_WEBHOOK=your-page-load-webhook-id
N8N_DEPLOY_WEBHOOK=your-deploy-webhook-id
N8N_AI_WEBHOOK=your-ai-webhook-id
N8N_LOG_SYNC_WEBHOOK=your-log-sync-webhook-id

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=m2studioscbe-dotcom
GITHUB_REPO_NAME=m2studios-website

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_PROJECT_NAME=m2studios-website

# AI API Keys
VY_API_KEY=your_vy_vercept_api_key
COMET_AI_KEY=your_comet_ai_api_key
OPENAI_API_KEY=your_openai_api_key_if_needed
